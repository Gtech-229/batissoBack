// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// A member of the Bâtisso team using the web admin (email + password).
/// A named set of permissions the super admin gives to admins (feature 20).
/// `permissions` holds names from the code's list (`src/admin-auth/permissions.ts`).
model AccessRole {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(60)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins Admin[]

  @@map("admin_roles")
}

model Admin {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique
  firstName           String
  lastName            String
  /// Null until the admin sets it from an emailed link (feature 22).
  passwordHash        String?
  role                AdminRole
  /// The role of an ADMIN (feature 20). A SUPER_ADMIN has none and holds every
  /// permission; an ADMIN without one reaches only their own account.
  roleId              String?   @db.Uuid
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accessRole           AccessRole?          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy            Admin?               @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins        Admin[]              @relation("AdminCreatedBy")
  sessions             AdminSession[]
  passwordTokens       AdminPasswordToken[]
  updatedSettings      SystemSettings[]
  // Feature 3: stores this admin registered, status changes, settings edits.
  storesCreated        HardwareStore[]      @relation("StoreCreatedBy")
  storeStatusChanges   HardwareStore[]      @relation("StoreStatusChangedBy")
  storeSettingsUpdates StoreSettings[]
  // Feature 16a: subscriptions this admin recorded or last edited.
  subscriptionsCreated Subscription[]       @relation("SubscriptionCreatedBy")
  subscriptionsUpdated Subscription[]       @relation("SubscriptionUpdatedBy")
  // Feature 16b: accounts this admin last suspended or reactivated.
  accountStatusChanges Account[]            @relation("AccountStatusChangedBy")
  resolvedAlerts       AdminAlert[]

  @@map("admins")
}

/// One login of an admin in one browser. Only the refresh token's hash is stored.
model AdminSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  adminId          String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@map("admin_sessions")
}

enum PasswordTokenMode {
  SET
  RESET
}

/// A link emailed to an admin to set (first time) or reset their password
/// (feature 22). Only the SHA-256 of the token is stored; single use, 3 days.
model AdminPasswordToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  adminId   String            @db.Uuid
  mode      PasswordTokenMode
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@map("admin_password_tokens")
}

/// Platform-wide settings editable by admins. A single row (id = 1); until it
/// exists, the code uses its defaults.
model SystemSettings {
  id               Int      @id @default(1)
  maxLoginAttempts Int
  maxAdminSessions Int
  /// Wrong PINs before a mobile user is locked for 15 minutes; 0 = no limit.
  /// The database default keeps an existing row valid.
  maxPinAttempts   Int      @default(5)
  updatedAt        DateTime @updatedAt
  updatedById      String?  @db.Uuid

  updatedBy Admin? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

enum StoreStatus {
  PENDING
  VERIFIED
  SUSPENDED
  CLOSED
}

enum StoreMemberRole {
  SELLER
  MANAGER
}

/// What an activity log entry records. Later features add their actions.
enum ActivityAction {
  SELLER_ADDED
  SELLER_DEACTIVATED
  SELLER_REACTIVATED
  ACCOUNT_OPENED
  ID_PHOTO_UPLOADED
  ARTICLE_CATEGORY_CREATED
  ARTICLE_CATEGORY_RENAMED
  ARTICLE_CREATED
  ARTICLE_UPDATED
  ARTICLE_PRICE_CHANGED
  STORE_QR_CODE_REGENERATED
  /// A manager reset a user's access after a lost phone (14a).
  ACCESS_RESET
  /// A manager removed a user's security answers, in a reset (14b).
  SECURITY_QUESTIONS_CLEARED
  /// A staff member or the customer attached a proof (24).
  PROOF_ATTACHED
  /// A manager removed a proof, with a reason (24).
  PROOF_REMOVED
  /// A manager exported a report as a file: data left the app (15b).
  REPORT_EXPORTED
}

enum AccountStatus {
  ACTIVE
  /// Suspended by an admin (16b): no deposits and no goal moves; purchases
  /// are still served.
  SUSPENDED
}

enum GoalStatus {
  IN_PROGRESS
  REACHED
  CLOSED
}

/// A country the platform operates in. Its currency is the currency of every
/// store and account in it; there is never any conversion.
model Country {
  code           String   @id @db.VarChar(2) /// ISO 3166-1 alpha-2, uppercase
  name           String
  phonePrefix    String /// Derived from the code, e.g. +223
  currencyCode   String   @db.VarChar(3) /// ISO 4217, e.g. XOF
  currencySymbol String
  decimals       Int /// Digits after the decimal point in amounts (XOF: 0)
  language       String   @default("fr") @db.VarChar(2)
  active         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stores HardwareStore[]

  @@map("countries")
}

/// A hardware store (quincaillerie) using Bâtisso.
model HardwareStore {
  id                     String            @id @default(uuid(7)) @db.Uuid
  countryCode            String            @db.VarChar(2)
  name                   String
  address                String
  city                   String
  phone                  String /// E.164
  tradeRegister          String
  status                 StoreStatus       @default(PENDING)
  verifiedAt             DateTime?
  statusChangedAt        DateTime?
  statusChangedById      String?           @db.Uuid
  statusReason           String?
  /// The store's QR code (feature 23): a random opaque code customers scan to
  /// reach their account here. Created on first read; regenerating replaces it.
  qrCode                 String?           @unique @db.VarChar(32)
  /// Null for a store that registered itself (feature 21).
  createdById            String?           @db.Uuid
  /// The user who registered the store from the app (feature 21b); unique:
  /// a user registers one store, ever. Null for a store an admin registered.
  registeredById         String?           @unique @db.Uuid
  /// The plan the registrant asked for, shown to admins (who record the
  /// subscription by hand, 16a).
  requestedPlan          SubscriptionPlan?
  /// Generated file names in STORE_DOCUMENT_DIR (21b), never in a response.
  managerIdPhotoPath     String?
  tradeRegisterPhotoPath String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  country         Country            @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  createdBy       Admin?             @relation("StoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  statusChangedBy Admin?             @relation("StoreStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  registeredBy    User?              @relation("StoreRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  settings        StoreSettings?
  members         StoreMember[]
  activityLogs    ActivityLog[]
  accounts        Account[]
  operations      Operation[]
  notifications   Notification[]
  categories      ArticleCategory[]
  articles        Article[]
  materialOrders  MaterialOrder[]
  disputes        Dispute[]
  proofs          TransactionProof[]
  cashClosings    CashClosing[]
  subscriptions   Subscription[]
  adminAlerts     AdminAlert[]

  @@index([status, createdAt])
  // Stores of a country (country store counts, filters by country).
  @@index([countryCode])
  @@map("hardware_stores")
}

enum SubscriptionPlan {
  TRIAL
  STANDARD
  PRO
}

/// A store's subscription (feature 16a), recorded by an admin: a plan over a
/// period of calendar days, both included. Recorded only: no billing, no plan
/// limits. Its status (upcoming, active, expired) is computed from today's
/// date, never stored. Two subscriptions of a store never overlap.
model Subscription {
  id          String           @id @default(uuid(7)) @db.Uuid
  storeId     String           @db.Uuid
  plan        SubscriptionPlan
  startsOn    DateTime         @db.Date
  endsOn      DateTime         @db.Date
  createdById String?          @db.Uuid
  updatedById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store     HardwareStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy Admin?        @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Admin?        @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([storeId, startsOn])
  @@map("subscriptions")
}

/// Money rules of one store. Amounts are integers in the smallest currency unit.
model StoreSettings {
  storeId             String   @id @db.Uuid
  maxBalance          BigInt
  validationThreshold BigInt
  minDeposit          BigInt
  refundAllowed       Boolean  @default(false) /// Off for every store in V1
  reservationEnabled  Boolean  @default(false) /// Off for every store in V1
  terms               String?
  /// Days after the customer's confirmation before they may ask to cancel an
  /// undelivered order (11c). 1 to 365 (a CHECK).
  deliveryDelayDays   Int      @default(30)
  updatedAt           DateTime @updatedAt
  updatedById         String?  @db.Uuid

  store     HardwareStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy Admin?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

/// A person using the mobile app (customer or store staff), identified by phone.
model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  phone                  String    @unique /// E.164
  firstName              String
  lastName               String
  /// scrypt hash of the 6-digit PIN; null until the user activates the app.
  pinHash                String?
  failedPinAttempts      Int       @default(0)
  pinLockedUntil         DateTime?
  /// The user's QR code (feature 23): a random opaque code a store scans to
  /// reach their account there. Created on first read; regenerating replaces it.
  qrCode                 String?   @unique @db.VarChar(32)
  /// Wrong recovery tries (14b): 3 lock recovery for 24 hours.
  failedRecoveryAttempts Int       @default(0)
  recoveryLockedUntil    DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  memberships         StoreMember[]
  registeredStore     HardwareStore?          @relation("StoreRegisteredBy")
  activityLogs        ActivityLog[]
  devices             UserDevice[]
  sessions            UserSession[]
  // Feature 5a: savings accounts held, and accounts opened as staff.
  accounts            Account[]               @relation("AccountCustomer")
  openedAccounts      Account[]               @relation("AccountOpenedBy")
  // Feature 6: operations recorded, and validated (orders, feature 10).
  operations          Operation[]             @relation("OperationAuthor")
  validations         Operation[]             @relation("OperationValidatedBy")
  // Feature 7: notifications sent to this user.
  notifications       Notification[]
  // Feature 8: money moved between goals.
  goalMovements       GoalMovement[]
  // Feature 10a: material orders prepared, validated, refused, cancelled.
  ordersCreated       MaterialOrder[]         @relation("OrderCreatedBy")
  ordersValidated     MaterialOrder[]         @relation("OrderValidatedBy")
  ordersRefused       MaterialOrder[]         @relation("OrderRefusedBy")
  ordersCancelled     MaterialOrder[]         @relation("OrderCancelledBy")
  orderCodesRequested OrderConfirmationCode[]
  // Feature 10c: material orders handed over.
  ordersDelivered     MaterialOrder[]         @relation("OrderDeliveredBy")
  // Feature 12: disputes opened, and messages written in their threads.
  disputesOpened      Dispute[]
  disputeMessages     DisputeMessage[]
  // Feature 13: cash closings made as the manager.
  cashClosings        CashClosing[]
  // Feature 14b: the answers to the user's security questions.
  securityAnswers     UserSecurityAnswer[]
  // Feature 24: proofs attached, and removed as the manager.
  proofsUploaded      TransactionProof[]      @relation("ProofUploadedBy")
  proofsRemoved       TransactionProof[]      @relation("ProofRemovedBy")

  @@map("users")
}

/// A security question on offer (14b). The list is set by migrations. A text
/// never changes: users answered it. Retired (`active` false), it stays for
/// those who chose it.
model SecurityQuestion {
  id        String   @id @default(uuid(7)) @db.Uuid
  text      String   @unique @db.VarChar(200)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  answers UserSecurityAnswer[]

  @@map("security_questions")
}

/// A user's answer to one security question: 3 to 5 rows per user, or none.
model UserSecurityAnswer {
  userId     String   @db.Uuid
  questionId String   @db.Uuid
  /// Normalized answer, hashed like a PIN (pepper, then scrypt).
  answerHash String
  createdAt  DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SecurityQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([userId, questionId])
  @@map("user_security_answers")
}

/// A one-time SMS code sent to a phone. Once the code is verified, it becomes a
/// short single-use token (bound to one device) for setting or checking the PIN.
model PhoneVerification {
  id             String    @id @default(uuid(7)) @db.Uuid
  phone          String /// E.164
  codeHash       String /// scrypt hash of the 6-digit code
  expiresAt      DateTime
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  deviceId       String?   @db.VarChar(100)
  tokenHash      String?   @unique /// SHA-256 of the verification token
  tokenExpiresAt DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("phone_verifications")
}

/// An app installation a user proved with an SMS code. Signing in on it then
/// needs only the PIN.
model UserDevice {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  /// Random id the app creates once per installation (not a secret on its own).
  deviceId   String   @db.VarChar(100)
  name       String?  @db.VarChar(100)
  /// P-256 public key (SPKI DER, base64) of the key pair created in the phone's
  /// secure hardware. Signing a challenge with the private key proves the device.
  publicKey  String?
  /// The installation's push (FCM) registration token; null: no push. Unique: a
  /// token moving to another account is taken off the previous one.
  pushToken  String?  @unique @db.VarChar(4096)
  trustedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions      UserSession[]
  notifications Notification[]

  @@unique([userId, deviceId])
  @@map("user_devices")
}

/// A random value a device must sign to sign in. Single-use, valid 2 minutes;
/// issued for any phone and device, so asking for one reveals nothing.
model DeviceChallenge {
  id        String    @id @default(uuid(7)) @db.Uuid
  phone     String    @db.VarChar(30)
  deviceId  String    @db.VarChar(100)
  /// Not a secret: sent to the app, which signs it.
  challenge String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("device_challenges")
}

/// One sign-in of a user on one device. Only the refresh token's hash is stored.
model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  deviceId         String    @db.Uuid /// UserDevice.id
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([deviceId])
  @@map("user_sessions")
}

/// A user working in a store, as seller or manager.
model StoreMember {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @db.Uuid
  storeId   String          @db.Uuid
  role      StoreMemberRole
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  store HardwareStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  // Members of a store (store detail); the unique index above starts with userId.
  @@index([storeId])
  @@map("store_members")
}

/// Who did what in a store, from which device, and when. Written in the same
/// transaction as the change it records; never updated or deleted by the API.
/// Values never hold a PIN, code, token, or hash.
model ActivityLog {
  id        String         @id @default(uuid(7)) @db.Uuid
  storeId   String?        @db.Uuid
  /// The author of the action.
  userId    String         @db.Uuid
  action    ActivityAction
  oldValue  Json?
  newValue  Json?
  /// The app's deviceId of the author's session.
  device    String?        @db.VarChar(100)
  createdAt DateTime       @default(now())

  store HardwareStore? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@map("activity_logs")
}

/// A customer's savings account in one store. Money columns are integers in the
/// smallest currency unit. The balance is a projection: deposits and debits
/// (feature 6) update it in the same transaction as the operation they record.
model Account {
  id                String        @id @default(uuid(7)) @db.Uuid
  /// "C-" + at least 6 digits from the account_number_seq sequence. For display
  /// and staff search only: sequential, so never enough to reach an account.
  number            String        @unique @db.VarChar(20)
  customerId        String        @db.Uuid
  storeId           String        @db.Uuid
  /// The store's country currency at opening (ISO 4217).
  currencyCode      String        @db.VarChar(3)
  balance           BigInt        @default(0)
  beneficiaryName   String?       @db.VarChar(100)
  beneficiaryPhone  String? /// E.164
  /// The identity photo: a generated file name (uuid + .jpg or .png) in the
  /// private ID_PHOTO_DIR directory; null until uploaded. Never in a response.
  idPhotoPath       String?       @db.VarChar(100)
  status            AccountStatus @default(ACTIVE)
  /// Why an admin suspended it (16b): for staff and admins, never the customer.
  statusReason      String?       @db.VarChar(500)
  statusChangedAt   DateTime?
  statusChangedById String?       @db.Uuid
  /// When the customer accepted the store's terms: at the counter, or in the
  /// app when they joined the store themselves (21c).
  termsAcceptedAt   DateTime
  /// The staff member who opened the account.
  openedById        String        @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer        User               @relation("AccountCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  statusChangedBy Admin?             @relation("AccountStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
  store           HardwareStore      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  openedBy        User               @relation("AccountOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  goals           Goal[]
  operations      Operation[]
  projects        Project[]
  goalMovements   GoalMovement[]
  materialOrders  MaterialOrder[]
  disputes        Dispute[]
  proofs          TransactionProof[]
  adminAlerts     AdminAlert[]

  @@unique([customerId, storeId])
  // The store's accounts, newest first (staff list and search).
  @@index([storeId, createdAt])
  @@map("accounts")
}

/// A savings goal of an account. Every account has exactly one system goal,
/// "Non affecté" (Unassigned), enforced by a partial unique index written in the
/// migration (Prisma cannot declare one); no route renames or deletes it.
model Goal {
  id           String     @id @default(uuid(7)) @db.Uuid
  accountId    String     @db.Uuid
  label        String     @db.VarChar(100)
  /// Null for the Unassigned goal.
  targetAmount BigInt?
  status       GoalStatus @default(IN_PROGRESS)
  isSystem     Boolean    @default(false)
  /// Projection, like Account.balance: changed only in the transaction of an
  /// operation (or a goal movement, feature 8). The goals of an account always
  /// sum to its balance.
  balance      BigInt     @default(0)
  /// The project the goal belongs to, if any (a goal can stand alone).
  projectId    String?    @db.Uuid
  /// When the balance last reached the target (status REACHED).
  reachedAt    DateTime?
  /// The article the goal saves for, if any: its view shows the balance as a
  /// quantity of that article (material equivalence, feature 9).
  articleId    String?    @db.Uuid
  createdAt    DateTime   @default(now())

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  article        Article?        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  operations     Operation[]
  movementsOut   GoalMovement[]  @relation("GoalMovementSource")
  movementsIn    GoalMovement[]  @relation("GoalMovementTarget")
  materialOrders MaterialOrder[]
  adminAlerts    AdminAlert[]

  @@index([accountId])
  @@map("goals")
}

/// A construction project of an account ("Ma maison"), grouping goals.
/// Never deleted.
model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  accountId String   @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  goals   Goal[]

  @@index([accountId])
  @@map("projects")
}

/// A category of a store's catalogue ("Ciment"). Each store has its own list,
/// created with the default set and extended by its managers. The name is
/// unique per store ignoring case (an index on lower(name) in the migration).
/// Never deleted.
model ArticleCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  storeId   String   @db.Uuid
  name      String   @db.VarChar(60)
  createdAt DateTime @default(now())

  store    HardwareStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  articles Article[]

  @@index([storeId])
  @@map("article_categories")
}

/// An article of a store's catalogue. The name is unique per store ignoring
/// case (an index on lower(name) in the migration). Never deleted: an article
/// no longer sold is marked unavailable.
model Article {
  id           String   @id @default(uuid(7)) @db.Uuid
  storeId      String   @db.Uuid
  categoryId   String   @db.Uuid
  name         String   @db.VarChar(100)
  /// Free text: "sac de 50 kg", "barre de 12 m".
  unit         String   @db.VarChar(50)
  /// The price of the day, in the currency's smallest unit (> 0, a CHECK).
  /// Changed only together with a new PriceHistory row.
  currentPrice BigInt
  available    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store      HardwareStore       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category   ArticleCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices     PriceHistory[]
  goals      Goal[]
  orderLines MaterialOrderLine[]

  @@index([storeId, categoryId])
  @@map("articles")
}

/// Every price an article has had, from its creation; the newest row is its
/// current price. The API only inserts rows.
model PriceHistory {
  id        String   @id @default(uuid(7)) @db.Uuid
  articleId String   @db.Uuid
  /// In the currency's smallest unit (> 0, a CHECK).
  price     BigInt
  startsAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@index([articleId, startsAt])
  @@map("price_history")
}

/// Where a material order stands (features 10a, 10b, 10c, and 11b).
enum MaterialOrderStatus {
  /// A seller's order above the store's validation threshold.
  AWAITING_VALIDATION
  /// Validated (or not needing it): the customer must confirm (10b).
  AWAITING_CUSTOMER
  REFUSED_BY_MANAGER
  /// Cancelled by its preparer or the manager before confirmation.
  CANCELLED
  /// The customer confirmed: the MATERIAL_DEBIT operation is written.
  CONFIRMED
  /// The customer refused it; the manager is alerted.
  REFUSED_BY_CUSTOMER
  /// Handed over in full to the customer (10c), from CONFIRMED only.
  DELIVERED
  /// Cancelled by the manager after the debit; the total was re-credited (11b).
  CANCELLED_AFTER_DEBIT
}

/// How the customer confirmed an order (10b).
enum OrderConfirmationChannel {
  /// Their PIN, in the app.
  PIN
  /// A one-time code texted to them, read out to the seller at the counter.
  SMS_CODE
}

/// A material order ("bon de sortie"): articles a customer takes from the
/// store, paid from one goal of their account (then Unassigned). Unit prices,
/// names, and units are frozen on its lines at preparation. No money moves
/// until the customer confirms (10b). The row records who did each step.
/// A photo of the paper behind a deposit or a material order (24): a receipt, or
/// a contract the customer signed by hand. It never changes what it is attached
/// to. Removing one deletes the file and keeps the row. Exactly one target, and
/// the removal fields go together (CHECKs in the migration).
model TransactionProof {
  id            String    @id @default(uuid(7)) @db.Uuid
  storeId       String    @db.Uuid
  accountId     String    @db.Uuid
  operationId   String?   @db.Uuid
  orderId       String?   @db.Uuid
  /// Generated by the storage, in `PROOF_DIR`. Null once removed. Never in a
  /// view or a log.
  fileName      String?
  uploadedById  String    @db.Uuid
  createdAt     DateTime  @default(now())
  removedAt     DateTime?
  removedById   String?   @db.Uuid
  removalReason String?

  store      HardwareStore  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  account    Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  operation  Operation?     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  order      MaterialOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploadedBy User           @relation("ProofUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy  User?          @relation("ProofRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([operationId])
  @@index([orderId])
  @@map("transaction_proofs")
}

model MaterialOrder {
  id                        String                    @id @default(uuid(7)) @db.Uuid
  /// Human reference: "B-" and at least 5 digits (B-00042), one platform-wide
  /// sequence (material_order_reference_seq).
  reference                 String                    @unique @db.VarChar(20)
  storeId                   String                    @db.Uuid
  accountId                 String                    @db.Uuid
  /// The goal paid from first; the Unassigned goal pays the rest (10b).
  goalId                    String                    @db.Uuid
  status                    MaterialOrderStatus
  /// Sum of the lines, in the currency's smallest unit (> 0, a CHECK).
  total                     BigInt
  createdById               String                    @db.Uuid
  validatedById             String?                   @db.Uuid
  validatedAt               DateTime?
  refusedById               String?                   @db.Uuid
  refusedAt                 DateTime?
  refusalReason             String?                   @db.VarChar(500)
  cancelledById             String?                   @db.Uuid
  cancelledAt               DateTime?
  cancellationReason        String?                   @db.VarChar(500)
  /// The MATERIAL_DEBIT operation written at confirmation (10b).
  operationId               String?                   @unique @db.Uuid
  confirmedAt               DateTime?
  confirmedVia              OrderConfirmationChannel?
  customerRefusedAt         DateTime?
  customerRefusalReason     String?                   @db.VarChar(500)
  /// Handed over in full (10c): set together, once, by the staff member.
  deliveredById             String?                   @db.Uuid
  deliveredAt               DateTime?
  /// The CORRECTION that re-credited the total when the manager cancelled the
  /// order after its debit (11b).
  recreditOperationId       String?                   @unique @db.Uuid
  /// The customer asked to cancel it, undelivered after the store's delivery
  /// delay (11c): set once, never cleared; the order stays CONFIRMED.
  cancellationRequestedAt   DateTime?
  cancellationRequestReason String?                   @db.VarChar(500)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  store             HardwareStore           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  account           Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  goal              Goal                    @relation(fields: [goalId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedBy       User?                   @relation("OrderValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  refusedBy         User?                   @relation("OrderRefusedBy", fields: [refusedById], references: [id], onDelete: Restrict)
  cancelledBy       User?                   @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  deliveredBy       User?                   @relation("OrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  operation         Operation?              @relation("OrderDebit", fields: [operationId], references: [id], onDelete: Restrict)
  recreditOperation Operation?              @relation("OrderRecredit", fields: [recreditOperationId], references: [id], onDelete: Restrict)
  lines             MaterialOrderLine[]
  confirmationCodes OrderConfirmationCode[]
  goalMovements     GoalMovement[]

  // The store's orders and an account's orders, newest first.
  proofs TransactionProof[]

  @@index([storeId, createdAt])
  @@index([accountId, createdAt])
  @@map("material_orders")
}

/// A one-time code texted to the customer to confirm one order at the counter
/// (10b): stored hashed, valid 10 minutes, used up by 5 wrong attempts; only
/// the newest unconsumed code of an order is checked. Never logged.
model OrderConfirmationCode {
  id            String    @id @default(uuid(7)) @db.Uuid
  orderId       String    @db.Uuid
  /// scrypt hash of the 6-digit code.
  codeHash      String
  expiresAt     DateTime
  attempts      Int       @default(0)
  /// Set when used, replaced by a newer code, or used up by wrong attempts.
  consumedAt    DateTime?
  /// The staff member who asked for it.
  requestedById String    @db.Uuid
  createdAt     DateTime  @default(now())

  order       MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_confirmation_codes")
}

/// One article of a material order, frozen at preparation: a later price
/// change, rename, or new unit never changes it.
model MaterialOrderLine {
  id          String @id @default(uuid(7)) @db.Uuid
  orderId     String @db.Uuid
  articleId   String @db.Uuid
  articleName String @db.VarChar(100)
  unit        String @db.VarChar(50)
  /// Whole units (> 0, a CHECK).
  quantity    Int
  /// The price of the day at preparation (> 0, a CHECK).
  unitPrice   BigInt

  order   MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  article Article       @relation(fields: [articleId], references: [id], onDelete: Restrict)

  // An article appears at most once per order.
  @@unique([orderId, articleId])
  @@map("material_order_lines")
}

/// Why money moved between two goals of an account.
enum GoalMovementReason {
  /// The customer moved it.
  MOVE
  /// A goal was closed: its balance went back to Unassigned.
  GOAL_CLOSED
  /// An order's goal held less than its total: Unassigned paid the rest (10b).
  ORDER_SHORTFALL
  /// A correction's goal held less than its amount: Unassigned paid the rest (11a).
  CORRECTION_SHORTFALL
  /// A paid order was cancelled: the goal gives back to Unassigned the
  /// shortfall it had covered (11b).
  ORDER_CANCELLATION
}

/// Money moved from one goal to another of the same account. Not an operation:
/// the account balance does not change, only how it is split. Append-only, like
/// operations (a database trigger refuses UPDATE and DELETE).
model GoalMovement {
  id             String             @id @default(uuid(7)) @db.Uuid
  accountId      String             @db.Uuid
  sourceGoalId   String             @db.Uuid
  targetGoalId   String             @db.Uuid
  /// Smallest currency unit, > 0 (check constraint).
  amount         BigInt
  reason         GoalMovementReason
  /// The user who moved it (the customer, for a move or a closing).
  authorId       String             @db.Uuid
  /// The client's key for a move; null for a closing (no retry to dedupe).
  idempotencyKey String?            @unique @db.Uuid
  device         String?            @db.VarChar(100)
  /// The order whose shortfall it paid (ORDER_SHORTFALL only).
  orderId        String?            @db.Uuid
  createdAt      DateTime           @default(now())

  account    Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order      MaterialOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceGoal Goal           @relation("GoalMovementSource", fields: [sourceGoalId], references: [id], onDelete: Restrict)
  targetGoal Goal           @relation("GoalMovementTarget", fields: [targetGoalId], references: [id], onDelete: Restrict)
  author     User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // An account's movements, newest first.
  @@index([accountId, createdAt])
  @@map("goal_movements")
}

enum OperationType {
  DEPOSIT
  MATERIAL_DEBIT
  CORRECTION
  REFUND /// V2: no endpoint in V1
}

enum OperationDirection {
  CREDIT
  DEBIT
}

enum OperationStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum OperationChannel {
  CASH
  MOBILE_MONEY /// V2: no endpoint in V1
}

/// One money movement on an account: the source of truth of every balance.
/// Append-only: a database trigger (migration `ledger`) refuses any UPDATE or
/// DELETE; a mistake is fixed by a new CORRECTION linked to the original.
/// Later features (orders, corrections, reports, the nightly check) rely on
/// this shape.
model Operation {
  id                   String             @id @default(uuid(7)) @db.Uuid
  /// Human reference: a type prefix and at least 5 digits (D-00482).
  reference            String             @unique @db.VarChar(20)
  accountId            String             @db.Uuid
  storeId              String             @db.Uuid
  /// Every operation targets a goal; deposits go to the Unassigned goal.
  goalId               String             @db.Uuid
  type                 OperationType
  /// Smallest currency unit, always > 0 (check constraint); `direction` says
  /// which way it moves.
  amount               BigInt
  direction            OperationDirection
  currencyCode         String             @db.VarChar(3)
  balanceBefore        BigInt
  balanceAfter         BigInt
  status               OperationStatus
  /// The staff member who recorded it.
  authorId             String             @db.Uuid
  /// The manager who validated it (orders above the threshold, feature 10).
  validatedById        String?            @db.Uuid
  customerConfirmedAt  DateTime?
  /// The operation a CORRECTION fixes (feature 11). A CHECK makes a
  /// CORRECTION always carry it and a reason, and no other type carry it.
  correctedOperationId String?            @db.Uuid
  reason               String?            @db.VarChar(500)
  channel              OperationChannel
  externalReference    String?            @db.VarChar(100)
  /// The client's key for this request: a retry never records twice.
  idempotencyKey       String             @unique @db.Uuid
  /// The app's deviceId of the author's session.
  device               String?            @db.VarChar(100)
  createdAt            DateTime           @default(now())

  account            Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  store              HardwareStore         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  goal               Goal                  @relation(fields: [goalId], references: [id], onDelete: Restrict)
  author             User                  @relation("OperationAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  validatedBy        User?                 @relation("OperationValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  correctedOperation Operation?            @relation("OperationCorrection", fields: [correctedOperationId], references: [id], onDelete: Restrict)
  correctedBy        Operation[]           @relation("OperationCorrection")
  notifications      Notification[]
  materialOrder      MaterialOrder?        @relation("OrderDebit")
  recreditedOrder    MaterialOrder?        @relation("OrderRecredit")
  disputes           Dispute[]
  proofs             TransactionProof[]
  cashClosing        CashClosingOperation?

  // An account's history, newest first.
  @@index([accountId, createdAt])
  // A store's operations by period (cash closing, reports).
  @@index([storeId, createdAt])
  @@map("operations")
}

/// What a notification is about. Each feature adds its own events.
enum NotificationType {
  DEPOSIT_RECORDED
  GOAL_REACHED
  /// An order awaits the customer's confirmation (10b).
  ORDER_AWAITING_CUSTOMER
  /// The debit of a confirmed order (10b).
  PURCHASE_RECORDED
  /// The customer refused an order: sent to the store's managers (10b).
  ORDER_REFUSED_BY_CUSTOMER
  /// A confirmed order was handed over: sent to the customer (10c).
  ORDER_DELIVERED
  /// A manager's correction of a deposit (11a).
  CORRECTION_RECORDED
  /// A paid order was cancelled and its total re-credited (11b).
  ORDER_CANCELLED_AFTER_DEBIT
  /// The customer asked to cancel an undelivered order: sent to the managers (11c).
  ORDER_CANCELLATION_REQUESTED
  /// A customer opened a dispute on an operation: sent to the managers (12).
  DISPUTE_OPENED
  /// The customer wrote again in a dispute: sent to the managers (12).
  DISPUTE_CUSTOMER_MESSAGE
  /// The store replied in a dispute: sent to the customer (12).
  DISPUTE_STORE_REPLY
  /// The customer closed a dispute (accepted or withdrew): sent to the managers (12).
  DISPUTE_CLOSED
  /// A manager reset the user's access: sent to that user (14a).
  ACCESS_RESET
  /// The user recovered their access with their security answers (14b).
  ACCESS_RECOVERED
  /// An admin suspended the customer's account (16b).
  ACCOUNT_SUSPENDED
  /// An admin reactivated the customer's account (16b).
  ACCOUNT_REACTIVATED
}

enum NotificationChannel {
  /// The in-app list: delivered as soon as it is written.
  APP
  /// One row per device with a push token.
  PUSH
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// One send of one message to one user on one channel: the notification log.
/// Rows are written in the transaction of the event (a committed deposit always
/// has its rows, a rolled-back one never), then sent after the commit. PENDING
/// and FAILED rows are retried by the scheduled jobs (feature 17). Never holds
/// a phone number, a push token, or a provider's error text.
model Notification {
  id          String              @id @default(uuid(7)) @db.Uuid
  userId      String              @db.Uuid
  storeId     String?             @db.Uuid
  operationId String?             @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  title       String              @db.VarChar(100)
  body        String              @db.VarChar(500)
  /// The target device of a PUSH row.
  deviceId    String?             @db.Uuid
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  /// The error kind of the last failed send (e.g. "TimeoutError"), never its text.
  lastError   String?             @db.VarChar(100)
  sentAt      DateTime?
  /// When the user read it in the app (APP rows only).
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  store     HardwareStore? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  operation Operation?     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  device    UserDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // A user's in-app list, newest first.
  @@index([userId, channel, createdAt])
  // The retry job: PENDING and FAILED rows, oldest first.
  @@index([status, createdAt])
  @@map("notifications")
}

/// Where a dispute stands (feature 12). One that is not CLOSED is unique per
/// operation (a partial unique index).
enum DisputeStatus {
  /// Awaiting the store: just opened, or the customer wrote again.
  OPEN
  /// Awaiting the customer: the manager replied.
  ANSWERED
  /// The customer closed it (accepted, or withdrew). Final.
  CLOSED
}

/// Who wrote a message in a dispute's thread.
enum DisputeAuthor {
  CUSTOMER
  /// The store's manager; the customer sees only the store, never who.
  STORE
}

/// A customer's dispute of an operation of their account (feature 12): a
/// thread of messages with the store's manager. It never changes the
/// operation; a fix is a correction (11a) or a re-credit (11b).
model Dispute {
  id          String        @id @default(uuid(7)) @db.Uuid
  operationId String        @db.Uuid
  accountId   String        @db.Uuid
  storeId     String        @db.Uuid
  /// The customer who opened it.
  openedById  String        @db.Uuid
  status      DisputeStatus
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  closedAt    DateTime?

  operation Operation        @relation(fields: [operationId], references: [id], onDelete: Restrict)
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  store     HardwareStore    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  openedBy  User             @relation(fields: [openedById], references: [id], onDelete: Restrict)
  messages  DisputeMessage[]

  // The store's disputes and an account's disputes, newest first.
  @@index([storeId, createdAt])
  @@index([accountId, createdAt])
  @@map("disputes")
}

/// One message of a dispute's thread. Append-only (a trigger refuses UPDATE
/// and DELETE): the thread is proof.
model DisputeMessage {
  id        String        @id @default(uuid(7)) @db.Uuid
  disputeId String        @db.Uuid
  author    DisputeAuthor
  authorId  String        @db.Uuid
  /// Plain text, never interpreted; not blank (a CHECK).
  body      String        @db.VarChar(1000)
  createdAt DateTime      @default(now())

  dispute    Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  authorUser User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // A thread, oldest first.
  @@index([disputeId, createdAt])
  @@map("dispute_messages")
}

/// The manager's count of the store's cash (feature 13): what should be in the
/// drawer since the last closing, what was counted, and the difference. Final
/// (a trigger refuses UPDATE and DELETE): a counting mistake is explained in
/// the next closing. It never moves money.
model CashClosing {
  id               String   @id @default(uuid(7)) @db.Uuid
  storeId          String   @db.Uuid
  /// The manager who counted.
  managerId        String   @db.Uuid
  currencyCode     String   @db.VarChar(3)
  /// Sum of the DEPOSIT operations it counted.
  depositsTotal    BigInt
  /// Sum of the CORRECTION DEBIT operations it counted.
  correctionsTotal BigInt
  /// depositsTotal - correctionsTotal (a CHECK); can be negative.
  expectedTotal    BigInt
  countedTotal     BigInt
  /// countedTotal - expectedTotal (a CHECK): positive is extra cash.
  discrepancy      BigInt
  /// Required when the discrepancy is not 0 (a CHECK).
  justification    String?  @db.VarChar(500)
  /// The client's key for this request: a retry never closes twice.
  idempotencyKey   String   @unique @db.Uuid
  /// The app's deviceId of the manager's session.
  device           String?  @db.VarChar(100)
  createdAt        DateTime @default(now())

  store      HardwareStore          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  manager    User                   @relation(fields: [managerId], references: [id], onDelete: Restrict)
  operations CashClosingOperation[]

  // A store's closings, newest first.
  @@index([storeId, createdAt])
  @@map("cash_closings")
}

/// An operation a closing counted. operationId is the key: an operation is
/// counted in one closing only. This, not createdAt, is the period's boundary:
/// createdAt is its transaction's start, so an operation waiting on a closing's
/// lock would look older than the closing and the next one would miss it.
/// Append-only (a trigger).
model CashClosingOperation {
  operationId String @id @db.Uuid
  closingId   String @db.Uuid

  operation Operation   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  closing   CashClosing @relation(fields: [closingId], references: [id], onDelete: Restrict)

  @@index([closingId])
  @@map("cash_closing_operations")
}

/// What an admin alert reports (17a; 17b adds its own type).
enum AdminAlertType {
  /// Account.balance differs from the sum of the account's operations.
  ACCOUNT_BALANCE_GAP
  /// A goal's balance differs from its operations and goal movements.
  GOAL_BALANCE_GAP
  /// The goals' balances do not add up to Account.balance.
  GOAL_SUM_GAP
}

/// A problem found by a scheduled job, for admins to look into (17a). Never a
/// balance: only the gap. One unresolved alert per type, account and goal (a
/// partial unique index in the migration, as Prisma cannot declare it).
model AdminAlert {
  id           String         @id @default(uuid(7)) @db.Uuid
  type         AdminAlertType
  storeId      String         @db.Uuid
  accountId    String         @db.Uuid
  /// The goal, for GOAL_BALANCE_GAP only.
  goalId       String?        @db.Uuid
  /// Stored minus computed, in the smallest currency unit.
  difference   BigInt
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?
  resolvedById String?        @db.Uuid

  store      HardwareStore @relation(fields: [storeId], references: [id], onDelete: Restrict)
  account    Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  goal       Goal?         @relation(fields: [goalId], references: [id], onDelete: Restrict)
  resolvedBy Admin?        @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([resolvedAt, createdAt])
  @@map("admin_alerts")
}
