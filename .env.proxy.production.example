# The HTTPS proxy's settings for docker-compose.prod.yml (feature 18b). Copy to
# .env.proxy.production on the VPS (git-ignored). Only nginx and certbot read
# it: neither sees the API's or the database's secrets.

# The API's public domain; its DNS A record must point at the VPS before the
# first certificate is requested.
API_DOMAIN=api.example.com
# The Let's Encrypt account contact (it no longer emails before a certificate
# expires: check expiry yourself, see README).
LETSENCRYPT_EMAIL=ops@example.com
