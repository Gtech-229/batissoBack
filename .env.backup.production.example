# The nightly backups' settings for docker-compose.prod.yml (feature 18c). Copy
# to .env.backup.production on the VPS (git-ignored); only the backup container
# reads it.
#
# Every backup file is encrypted with this passphrase, and restoring one needs
# it. Choose a long random one (20+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# and keep a copy somewhere safe that is NOT the backups (a password manager):
# lose it and the backups cannot be read. Left empty on purpose: the backup
# container refuses to run until it is set.
BACKUP_PASSPHRASE=
