# Production settings for docker-compose.prod.yml (feature 18a). Copy to
# .env.production on the VPS (git-ignored) and replace every placeholder: the
# secrets below are invalid on purpose, so an unedited copy cannot start.

NODE_ENV=production
PORT=3000

# The database: user, password and name from .env.db.production (the
# password is the one you chose there, before the first start).
DATABASE_URL=postgresql://batisso:change-me@db:5432/batisso

# The web admin's address(es).
CORS_ORIGINS=https://admin.example.com
ADMIN_WEB_URL=https://admin.example.com

# 32+ random characters each; too short on purpose. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
# Mixed into every PIN hash: keep it safe, changing it invalidates every PIN.
PIN_PEPPER=change-me

# Private folders, on the app-storage volume (included in the backups, 18c).
ID_PHOTO_DIR=/app/storage/id-photos
PROOF_DIR=/app/storage/proofs
STORE_DOCUMENT_DIR=/app/storage/store-documents

# Used once, to create the super admin when none exists. This placeholder breaks
# the password rule on purpose (8 to 128 characters with an uppercase letter, a
# lowercase letter, a digit and a special character). Quote it: an unquoted #
# starts a comment. Remove both lines once the super admin exists.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD="Changeme"
