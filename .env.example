DATABASE_URL=postgresql://batisso:batisso@localhost:5433/batisso
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# The web admin's address, used in the password links emailed to admins.
ADMIN_WEB_URL=http://localhost:5173
# Too short on purpose: the API refuses to start until you replace it with a real
# secret (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
# Mixed into every PIN hash; too short on purpose, like the secret above. Generate
# one the same way and keep it safe: changing it later invalidates every PIN.
PIN_PEPPER=change-me
# Private directory of the customers' identity photos (never served statically).
# On the VPS, a Docker volume included in the daily backups.
ID_PHOTO_DIR=storage/id-photos
PROOF_DIR=storage/proofs
SUPER_ADMIN_EMAIL=admin@batisso.local
# Used once, to create the super admin when none exists. This placeholder breaks
# the password rule on purpose (8 to 128 characters with an uppercase letter, a
# lowercase letter, a digit, and a special character): the API refuses to start
# until you choose a real one. Quote it: in an unquoted value, # starts a comment.
# Once the super admin exists, you can remove both SUPER_ADMIN_* lines.
SUPER_ADMIN_PASSWORD="Changeme"
