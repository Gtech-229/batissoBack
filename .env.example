DATABASE_URL=postgresql://batisso:batisso@localhost:5433/batisso
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
# Too short on purpose: the API refuses to start until you replace it with a real
# secret (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
SUPER_ADMIN_EMAIL=admin@batisso.local
# Quote it: in an unquoted value, # starts a comment.
SUPER_ADMIN_PASSWORD="Change#Me2026"
