# The PostgreSQL container's settings for docker-compose.prod.yml (18a). Copy to
# .env.db.production on the VPS (git-ignored); only the db container reads it.
#
# Choose a long random password BEFORE the first `up`: PostgreSQL reads it only
# when it creates the pgdata-prod volume, so a later edit does not change it.
# Letters and digits only, so it needs no escaping in DATABASE_URL, where the
# same password goes (.env.production). Left empty on purpose: the container
# refuses to create the database until it is set.
POSTGRES_USER=batisso
POSTGRES_PASSWORD=
POSTGRES_DB=batisso
